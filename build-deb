# Build an installable package for easy deployment and removal on test machines.
#
# Project details are inferred from debian/ rather than hard-coded here:
#   - Build dependencies come from Build-Depends in debian/control (apt build-dep).
#   - The source package name comes from debian/changelog and identifies output files.
#   - debian/rules selects the build system; this script does not need to know it.
#
# Usage: ./build-deb [options]
#
# Options:
#    -b, --binary          Build binary packages only (default).
#    -d, --install-deps    Install build dependencies first, then build.
#    -c, --clean           Clean build artifacts and exit.
#    -h, --help            Show help.

set -o pipefail

# This script lives alongside debian/ in the project root.
CUR_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJ_ROOT="$CUR_SCRIPT_DIR"

# Options
BUILD_BIN=true
INSTALL_DEPS=false
ACT_CLEANUPS=false

# Source package name, used to identify output files in the parent directory.
PKG_NAME=""

# Show help.
print_help() {
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  -b, --binary          Build binary packages only (default)"
    echo "  -d, --install-deps    Install build dependencies from debian/control, then build"
    echo "  -c, --clean           Clean build artifacts and exit"
    echo "  -h, --help            Show this help"
    echo ""
    echo "Examples:"
    echo "  $0 -d                # Install build dependencies and build"
    echo "  $0                   # Build with dependencies already installed"
    echo "  $0 -c                # Clean build artifacts"
    exit 0
}

# Parse arguments.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -b|--binary)
                BUILD_BIN=true
                shift
                ;;
            -c|--clean)
                ACT_CLEANUPS=true
                shift
                ;;
            -d|--install-deps)
                INSTALL_DEPS=true
                BUILD_BIN=true
                shift
                ;;
            -h|--help)
                print_help
                ;;
            *)
                echo "Unknown option: $1"
                echo "The following help may be useful:"
                print_help
                ;;
        esac
    done
}

# Check whether a command is available.
is_cmd_exists() {
    command -v "$1" &> /dev/null
}

# Validate the project layout and read the source package name.
detect_project() {
    if [[ ! -f "$PROJ_ROOT/debian/control" || ! -f "$PROJ_ROOT/debian/changelog" ]]; then
        echo "Error: debian/control or debian/changelog was not found under $PROJ_ROOT."
        echo "Place this script next to debian/ in the project root."
        exit 1
    fi
    PKG_NAME="$(cd "$PROJ_ROOT" && dpkg-parsechangelog -S Source 2>/dev/null)"
    if [[ -z "$PKG_NAME" ]]; then
        echo "Error: Could not read the source package name from debian/changelog."
        exit 1
    fi
    echo "Project root:   $PROJ_ROOT"
    echo "Source package: $PKG_NAME"
}

# Check basic tools; debian/control declares the remaining build dependencies.
check_toolchains() {
    echo "Checking basic build tools..."
    local missing_tools=()

    # dpkg-dev provides dpkg-buildpackage and dpkg-parsechangelog.
    if ! is_cmd_exists "dpkg-buildpackage"; then
        missing_tools+=("dpkg-dev")
    fi
    # apt-get build-dep installs declared build dependencies.
    if ! is_cmd_exists "apt-get"; then
        missing_tools+=("apt")
    fi

    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        echo "Missing basic tools: ${missing_tools[*]}"
        echo "Try: sudo apt install ${missing_tools[*]}"
        exit 1
    fi
    echo "Basic build tools are available."
}

# Install build dependencies from Build-Depends in debian/control.
auto_install_deps() {
    if [[ "$INSTALL_DEPS" != true ]]; then
        return
    fi
    echo "Installing build dependencies from debian/control..."
    sudo apt-get update

    echo ""
    echo ">>> Note: apt will ask for confirmation. Review packages to be installed or removed"
    echo ">>>       before proceeding, especially on a system with custom packages."
    echo ""
    # apt-get build-dep reads Build-Depends from this project's debian/control.
    sudo apt-get build-dep "$PROJ_ROOT"
    echo "Build dependencies installed."
}

# Pre-fetch Meson subprojects if present. During package builds, debhelper's
# Meson backend uses --wrap-mode=nodownload, so wraps must be downloaded first.
prefetch_subprojects() {
    [[ -d subprojects ]] || return 0
    shopt -s nullglob
    local wraps=(subprojects/*.wrap)
    shopt -u nullglob
    [[ ${#wraps[@]} -eq 0 ]] && return 0

    if ! is_cmd_exists meson; then
        echo "Warning: Meson is unavailable; skipping subproject downloads."
        return 0
    fi
    echo "Downloading Meson subprojects (existing directories are skipped)..."
    if ! meson subprojects download; then
        echo "Error: Meson subproject download failed; check network, Git, and wrap files."
        exit 1
    fi
}

# Clean build artifacts.
exec_clean() {
    echo "Cleaning build artifacts..."
    cd "$PROJ_ROOT" || exit 1

    # Let debhelper remove intermediate files under debian/.
    if [[ -f debian/rules ]]; then
        fakeroot debian/rules clean >/dev/null 2>&1 || dh clean >/dev/null 2>&1 || true
    fi

    # Remove common intermediate files as a fallback.
    rm -rf debian/.debhelper/ debian/tmp/
    rm -f debian/files debian/*.substvars debian/*.debhelper.log debian/debhelper-build-stamp
    rm -rf obj-*-linux-gnu/ obj-*/

    # Remove matching package artifacts in the parent directory.
    # The wildcard also covers multiple binary packages from one source.
    if [[ -n "$PKG_NAME" ]]; then
        rm -f ../"${PKG_NAME}"*_*.deb \
              ../"${PKG_NAME}"_*.buildinfo \
              ../"${PKG_NAME}"_*.changes \
              ../"${PKG_NAME}"_*.dsc \
              ../"${PKG_NAME}"_*.tar.* 2>/dev/null
    fi

    echo "Cleanup complete."
}

# Build packages.
exec_build() {
    local dpkg_args=("-us" "-uc")
    [[ "$BUILD_BIN" == true ]] && dpkg_args+=("-b")

    cd "$PROJ_ROOT" || exit 1
    prefetch_subprojects
    echo "Building with dpkg-buildpackage (options: ${dpkg_args[*]})..."
    dpkg-buildpackage "${dpkg_args[@]}"

    echo "Build complete. Debian packages should be in the parent directory:"
    ls -1 ../"${PKG_NAME}"*_*.deb 2>/dev/null || echo "  (No .deb found; check the build output above.)"
}

# Main entry point.
echo "============================================="
echo "      Pointer DEB Build Script REL 1.0.0"
echo "============================================="
echo ""

parse_args "$@"
detect_project

if [[ "$ACT_CLEANUPS" == true ]]; then
    exec_clean
    exit 0
fi

check_toolchains
auto_install_deps
exec_build
